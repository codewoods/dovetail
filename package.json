{
	"name": "@codewoods/dovetail",
	"version": "0.0.0-development",
	"homepage": "https://github.com/codewoods/dovetail",
	"private": true,
	"scripts": {
		"hooks:install": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then lefthook install; else echo 'Skipping Lefthook install outside a Git worktree'; fi",
		"prepare": "bun run hooks:install",
		"dev": "make dev",
		"verify": "make verify",
		"pre-push": "make pre-push",
		"contrast": "bun scripts/audit-apca.mjs",
		"data:hazard": "make data-hazard",
		"data:pmtiles": "make data-pmtiles",
		"coords": "bun scripts/extract-coords.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@ls-lint/ls-lint": "v2.3.1",
		"@types/node": "^25.8.0",
		"@usebruno/cli": "^3.3.0",
		"browserslist": "^4.28.2",
		"browserslist-config-wikimedia": "^0.7.0",
		"bun-types": "^1.3.0",
		"knip": "^6.14.1",
		"lefthook": "^2.1.6",
		"oxlint": "^1.65.0",
		"stylelint": "^17.11.1",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-declaration-block-no-ignored-properties": "^3.0.0",
		"stylelint-high-performance-animation": "^2.0.0",
		"stylelint-no-unsupported-browser-features": "^8.1.1",
		"stylelint-plugin-defensive-css": "^2.9.2",
		"stylelint-value-no-unknown-custom-properties": "^6.1.1",
		"ts-pattern": "^5.9.0",
		"typescript": "^6.0.3",
		"valibot": "^1.4.0",
		"vitest": "^4.1.2"
	},
	"browserslist": [
		"extends browserslist-config-wikimedia/modern"
	],
	"type": "module"
}
